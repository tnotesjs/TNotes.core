{
  "name": "@tnotesjs/core",
  "version": "0.8.0",
  "description": "TNotes 知识库核心框架 —— 基于 VitePress 的笔记管理系统",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "bin": {
    "tnotes": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "require": "./dist/workspace/index.cjs",
      "import": "./dist/workspace/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "require": "./dist/markdown/index.cjs",
      "import": "./dist/markdown/index.js"
    },
    "./vitepress/config": {
      "require": "./dist/vitepress/config/index.cjs",
      "import": "./dist/vitepress/config/index.js"
    },
    "./vitepress/theme": {
      "types": "./vitepress/theme/index.ts",
      "import": "./vitepress/theme/index.ts"
    },
    "./vitepress/*": "./vitepress/*"
  },
  "files": [
    "commands/",
    "config/",
    "core/",
    "markdown/",
    "services/",
    "utils/",
    "dist/",
    "templates/",
    "vitepress/",
    "types/",
    "workspace/"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "build:check": "tsc --noEmit -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.build.json",
    "dev": "tsup --watch",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "vitepress": "^1.6.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@tnotesjs/mindmap-core": "^0.2.2",
    "@tnotesjs/ui": "^0.1.1",
    "echarts": "^6.0.0",
    "github-slugger": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^15.0.11",
    "mermaid": "^11.5.0",
    "minisearch": "^7.2.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.90.0",
    "swiper": "^11.2.1",
    "uuid": "^11.1.0",
    "vue-echarts": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.6.2",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.6",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnotesjs/core.git"
  },
  "keywords": [
    "tnotes",
    "vitepress",
    "knowledge-base",
    "notes"
  ]
}
